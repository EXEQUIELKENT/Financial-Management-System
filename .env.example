# ---------------------------------------------------------------------------
# Environment variables for the Financial Management System.
#
# Copy to .env for local Docker runs, or paste the same keys into the hosting
# platform's Environment section. Every value below has a working default, so
# only the database group is genuinely required for a hosted deployment.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# 'production' hides PHP errors from visitors and closes sql/seed.php over HTTP.
APP_ENV=production

# URL prefix the app is served under. Leave empty when it owns the domain root
# (the hosted case). Auto-detected when unset, so an htdocs subfolder still works.
APP_BASE_URL=

APP_TIMEZONE=Asia/Manila
CURRENCY_SYMBOL=₱

# Guided tours and the Getting Started page. Off automatically when APP_ENV is
# production; set to true to keep them on a deployment (a training environment, say).
SHOW_GUIDES=false

# Minutes of inactivity before a session is dropped, in seconds.
IDLE_TIMEOUT_SECONDS=1800
SESSION_NAME=TRAVELCORE_FMS

# --- Web server ------------------------------------------------------------
# Port Apache binds to inside the container. Matches the Dockerfile's EXPOSE.
PORT=80

# --- Database (required) ---------------------------------------------------
# MariaDB and MySQL are both supported; the hosted deployment uses a managed MariaDB.
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=travelcore_fms
DB_USER=travelcore
DB_PASS=change-me
DB_TIMEOUT=10

# --- Embedded database (workaround) ---------------------------------------
# Runs MariaDB inside the application container instead of using a separate database
# service. Only for hosts that cannot provide one -- see docs/DEPLOYMENT.md. Leave this
# false whenever a real database is available.
#
# WARNING: the data lives at /var/lib/mysql inside the container. Without a persistent
# volume mounted there, every redeploy starts from an empty ledger.
DB_EMBEDDED=false

# Set DB_HOST=127.0.0.1 when DB_EMBEDDED=true.
# InnoDB buffer pool for the embedded server; it shares memory with Apache and PHP.
DB_EMBEDDED_BUFFER_POOL=64M

# --- First-boot database bootstrap ----------------------------------------
# Wait for the database to accept connections before starting Apache.
DB_WAIT=true
DB_WAIT_SECONDS=45

# Create the schema on boot if the database is empty. Safe to leave on: it is a
# no-op once the tables exist. Turn this on for the first deploy to a fresh database.
DB_AUTO_MIGRATE=true

# Load demo data (4 demo users, chart of accounts, ~7 months of transactions).
# Turn this OFF before recording real financial data.
DB_AUTO_SEED=false

# --- Outbound mail (password-reset codes) ----------------------------------
# Required for the "Forgot your password?" flow to actually deliver codes. With
# MAIL_PASSWORD empty the flow fails closed in production (no code is sent and none is
# revealed); outside production the code is shown on screen instead so the flow stays
# usable locally without an SMTP account.
#
# For Gmail, MAIL_PASSWORD must be a 16-character App Password from an account with
# 2-Step Verification enabled -- a normal account password will be rejected.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TravelCore FMS

# Reset-code behaviour.
OTP_VALIDITY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_WINDOW_SECONDS=900
